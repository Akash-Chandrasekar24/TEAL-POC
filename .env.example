
# Both extraction and SolidWorks planning/repair workers use this Domo model.
LLM_PROVIDER=domo
WORKER_LLM_PROVIDER=domo
DOMO_MODEL=domo.openai.gpt-5.6-sol
DOMO_REASONING_EFFORT=high
EXTRACTION_REASONING_EFFORT=medium
CAD_REASONING_EFFORT=high
# Set DOMO_INSTANCE and DOMO_DEVELOPER_TOKEN in your local .env.

# Domo calls at once per process (about 6 at once stalled for 10 minutes)
DOMO_MAX_IN_FLIGHT=2

# Process log of every run (storage/runs/<id>/): also keep the pictures sent to the model and its raw replies (off = events only)
TRACE_FILES=on

# Harness limits per workflow/job (persisted across part-job approval/resume).
HARNESS_MAX_MODEL_CALLS=64
HARNESS_MAX_TOKENS=1000000
HARNESS_MAX_MODEL_SECONDS=7200
HARNESS_MAX_ACTIONS=128
