# Copy this file to .env and fill it in. Never share or commit .env: it holds your API key.

# --- The language model that reads the drawing and suggests fixes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high
GEMINI_THINKING_LEVEL=medium
LLM_TIMEOUT_SECONDS=600

# --- SolidWorks part templates decide the units of the saved SLDPRT and the exported STEP.
# Empty = templates\Part_MMDS.PRTDOT of this project (millimetres). Inch drawings use the standard SolidWorks inch template unless set here.
SW_TEMPLATE_MM=
SW_TEMPLATE_INCH=
# Documents that may stay open in SolidWorks while a job runs (comma separated names, e.g. my_assembly). Empty = none.
SW_KEEP_OPEN_DOCS=

# --- The SolidWorks execution server (built by scripts\build_execution_layer.ps1)
# Keep the word "localhost" (the server rejects 127.0.0.1).
EXECUTION_BASE_URL=http://localhost:5000
# Empty = build\execution-bin\SolidworksExecution.exe of this project. Must never point into third_party\.
EXECUTION_EXE_PATH=
# Empty = the Python interpreter that runs the program (the MCP adapter runs in the same environment).
PYTHON_EXE=
