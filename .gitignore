# Secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data: jobs, logs, build leftovers, SolidWorks lock files
storage/
logs/
*.log
*.sqlite*
build/
~$*

# Other people's code (AGPL): fetch it yourself, see third_party/README.md
third_party/*
!third_party/README.md
!third_party/solidworks.lock.json
solidpilot/

# Benchmark runs (scores + overlay pictures)
eval/runs/

# Stray screenshots (put pictures under inputs/ or docs/)
/image*.png
/scripts/image.png
