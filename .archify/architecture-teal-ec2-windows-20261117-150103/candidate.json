  "cards": [
    {
      "dot": "rose",
      "title": "Handshake",
      "items": [
        "Pair once: a one-time code becomes a connector credential",
        "Connector dials out WSS 443 with mTLS: no inbound port on the Windows PC",
        "hello: id, version, SolidWorks version, licence OK, capacity 1"
      ]
    },
    {
      "dot": "cyan",
      "title": "Each job",
      "items": [
        "Hub offers a job; connector claims a lease and heartbeats every 15 s",
        "Inputs and outputs move through S3 presigned URLs",
        "Progress and agent reasoning stream back on the same socket",
        "Corrections from the compare-page chat run as edit jobs on the same PC"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the runner stays local",
      "items": [
        "A build makes hundreds of bridge and COM calls: too slow and fragile across the internet",
        "Runner, verifier and finish already use COM directly"
      ]
    },
    {
      "dot": "amber",
      "title": "When the PC is offline",
      "items": [
        "Jobs wait in the queue; the page shows SolidWorks offline",
        "Lease expires mid-build: the job is retried, steps are idempotent",
        "More Windows PCs = more connectors = more capacity"
      ]
    }
  ]
